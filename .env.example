# Every MIXHOUND_* value is optional; defaults live in mixhound.config.Settings.
# Nested sections use a double underscore. Uncomment a line to override it.

# Logging
# MIXHOUND_LOG__LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR, CRITICAL
# MIXHOUND_LOG__CONSOLE_LEVEL=DEBUG
# MIXHOUND_LOG__FILE_LEVEL=INFO
# MIXHOUND_LOG__FORMAT=console                  # console or json; file logs are always JSON
# MIXHOUND_LOG__DIR=./logs                      # file logging is disabled if unset
# MIXHOUND_LOG__FILE_NAME=mixhound.log          # basename only; no directory separators
# MIXHOUND_LOG__FILE_MAX_BYTES=4194304
# MIXHOUND_LOG__FILE_BACKUP_COUNT=5

# HTTP API
# MIXHOUND_API__DOCS_ENABLED=true
# MIXHOUND_API__CORS_ORIGINS=[]                 # JSON list, e.g. ["http://localhost:5173"]

# Storage
# MIXHOUND_DATA_DIR=data                        # runs, caches and diagnostics
# MIXHOUND_SKILLS_DIR=.agents/skills
# MIXHOUND_STORAGE__BACKEND=files               # files or memory
# MIXHOUND_CACHE__ENABLED=true
# MIXHOUND_QUEUE__MAX_PENDING=20

# Public page fetching
# MIXHOUND_HTTP__TIMEOUT=5.0
# MIXHOUND_HTTP__USER_AGENT=mixhound/0.1
# MIXHOUND_HTTP__MAX_RETRIES=2
# MIXHOUND_HTTP__BACKOFF_BASE=0.5
# MIXHOUND_HTTP__BACKOFF_CAP=4.0
# MIXHOUND_HTTP__RETRY_AFTER_CAP=5.0

# Track data (deadwax)
# MIXHOUND_DEADWAX__CONTACT=https://github.com/rwrotson/mixhound
# MIXHOUND_DEADWAX__ADAPTER_TIMEOUT=30.0
# MIXHOUND_DEADWAX__SOURCES=["musicbrainz","itunes","lastfm"]  # JSON list; unset uses deadwax defaults
# MIXHOUND_DEADWAX__CACHE_ENABLED=true
# MIXHOUND_DEADWAX__LASTFM_API_KEY=
# MIXHOUND_DEADWAX__DISCOGS_TOKEN=
# MIXHOUND_DEADWAX__YOUTUBE_API_KEY=
# MIXHOUND_DEADWAX__SPOTIFY_CLIENT_ID=
# MIXHOUND_DEADWAX__SPOTIFY_CLIENT_SECRET=

# Web search
# MIXHOUND_SEARCH__BRAVE_API_KEY=
# MIXHOUND_SEARCH__RESULTS=10
# MIXHOUND_SEARCH__TIMEOUT=10.0
