# Every MIXHOUND_* value is optional; defaults live in mixhound.config.Settings.
# Nested sections use a double underscore. Uncomment a line to override it.

# Logging
# MIXHOUND_LOG__LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR, CRITICAL
# MIXHOUND_LOG__CONSOLE_LEVEL=DEBUG
# MIXHOUND_LOG__FILE_LEVEL=INFO
# MIXHOUND_LOG__FORMAT=console                  # console or json; file logs are always JSON
# MIXHOUND_LOG__DIR=./logs                      # file logging is disabled if unset
# MIXHOUND_LOG__FILE_NAME=mixhound.log          # basename only; no directory separators
# MIXHOUND_LOG__FILE_MAX_BYTES=4194304
# MIXHOUND_LOG__FILE_BACKUP_COUNT=5

# HTTP API
# MIXHOUND_API__DOCS_ENABLED=true
# MIXHOUND_API__CORS_ORIGINS=[]                 # JSON list, e.g. ["http://localhost:5173"]
